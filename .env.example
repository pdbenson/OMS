# ============================================================
# OMS Intake — Environment Variables
# Set all of these in Netlify: Site Settings > Environment Variables
# NEVER commit actual values to Git
# ============================================================

# ── SUPABASE ────────────────────────────────────────────────
# From: Supabase Dashboard > Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # Keep this secret — full DB access

# ── JWT ─────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_48_CHARACTER_RANDOM_STRING

# ── ADMIN AUTH ──────────────────────────────────────────────
ADMIN_EMAIL=info.davisoms@gmail.com

# Option A (simpler): plain password — never seen by browsers
ADMIN_PASSWORD=D@vis890!

# Option B (more secure): bcrypt hash — generate with:
#   node -e "const b=require('bcryptjs'); b.hash('D@vis890!',12).then(h=>console.log(h))"
# Then set this instead of ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=$2a$12$...

# ── SITE ────────────────────────────────────────────────────
SITE_URL=https://oms.tapat.dev

# ── EMAIL (HIPAA-compliant — NO PHI in email bodies) ────────
# Option A: Paubox (HIPAA-compliant, has BAA)
#   Sign up at paubox.com/plans, use SMTP relay
SMTP_HOST=smtp.paubox.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_paubox_username
SMTP_PASS=your_paubox_password
SMTP_FROM=noreply@davisoms.com
ADMIN_EMAIL=info.davisoms@gmail.com   # Where admin notifications go

# Option B: AWS SES (HIPAA eligible with BAA)
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=YOUR_SES_SMTP_USERNAME
# SMTP_PASS=YOUR_SES_SMTP_PASSWORD

# ── ALLOWED ORIGIN (optional CORS hardening) ────────────────
ALLOWED_ORIGIN=https://oms.tapat.dev
