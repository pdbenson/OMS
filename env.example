# ============================================================
# OMS Intake — Environment Variables
# Set these in Netlify: Site Configuration > Environment Variables
# NEVER commit actual values to Git
# ============================================================

# Supabase (Settings > API in your Supabase project)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# JWT — generate with: node -e "require('crypto').randomBytes(48).toString('base64')"
JWT_SECRET=YOUR_RANDOM_SECRET_STRING

# Admin credentials
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# Site
SITE_URL=https://oms.tapat.dev
ADMIN_NOTIFY_EMAIL=YOUR_ADMIN_EMAIL

# SMTP — Paubox or AWS SES (HIPAA-compliant, BAA required)
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=YOUR_FROM_ADDRESS
